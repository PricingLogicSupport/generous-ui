{
  "name": "generous-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "An opinionated, adaptable React UI library built around generous clarity.",
  "license": "MIT",
  "author": "Pricing Logic",
  "homepage": "https://github.com/PricingLogicSupport/generous-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PricingLogicSupport/generous-ui.git"
  },
  "bugs": {
    "url": "https://github.com/PricingLogicSupport/generous-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "accessibility",
    "registry",
    "cli",
    "generous-clarity"
  ],
  "scripts": {
    "dev": "npm run registry:details && vite --host 127.0.0.1",
    "build": "npm run registry:details && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "behavior:check": "node scripts/behavior-check.mjs",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:check": "npm run typecheck && npm run registry:validate && npm run registry:coverage && npm run pack:check && npm run package:smoke",
    "prepublishOnly": "npm run release:check",
    "visual:check": "node scripts/visual-check.mjs",
    "registry:validate": "node scripts/registry.mjs validate",
    "registry:list": "node scripts/registry.mjs list",
    "registry:details": "node scripts/registry-details.mjs",
    "registry:coverage": "node scripts/registry.mjs coverage",
    "registry:show": "node scripts/registry.mjs show",
    "registry:add": "node scripts/registry.mjs add"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/generous-ui.js"
    },
    "./styles.css": "./dist/generous-ui.css",
    "./registry": "./generous-ui.registry.json"
  },
  "bin": {
    "generous-ui": "bin/generous-ui.mjs"
  },
  "files": [
    "BRAND.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASE.md",
    "bin",
    "dist",
    "generous-ui.config.schema.json",
    "generous-ui.registry.json",
    "generous-ui.registry.schema.json",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.60.0",
    "vite": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
