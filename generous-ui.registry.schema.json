{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generous UI Registry",
  "type": "object",
  "required": ["name", "version", "style", "description", "css", "components"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "css": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "files"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["control", "data", "display", "feedback", "form", "layout", "navigation", "pattern", "trust"]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
